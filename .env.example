# Google Maps Places API (New) key — enable "Places API (New)" in Google Cloud
GOOGLE_MAPS_API_KEY=

# Gmail / Drive OAuth. Put the OAuth client JSON in this repo as credentials.json
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Optional: LLM for more natural personalized emails (OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: Google Drive folder ID for report uploads (leave blank = My Drive root)
DRIVE_FOLDER_ID=
